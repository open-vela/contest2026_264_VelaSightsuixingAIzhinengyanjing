#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config LVX_USE_DEMO_CONTEST2026_264_CAMERA_PREVIEW
	bool "GC2145 -> GC9D01 live camera preview"
	default n
	depends on VIDEO_FB
	---help---
		Live preview command: captures 640x480 UYVY from /dev/video0,
		centre-crops to a square, scales to the panel size and pushes
		RGB565 frames to /dev/fb0.

		Samples the source directly into the framebuffer, so it needs no
		intermediate buffer -- which is what makes it usable on a board
		whose kernel heap is smaller than one camera frame.
